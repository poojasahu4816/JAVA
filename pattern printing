import java.util.*;
public class Advance_pattern {
    public static void main(String[] args) {
          Scanner sc = new Scanner(System.in);
        
for(int i = 1; i <= 4; i++) {

    for(int l =3; l >= i; l--) {
        System.out.print(" ");
    }

    for(int j =1; j<=i; j++) {
        System.out.print("*");
    }

    for(int k = 2; k<=i; k++) {
        System.out.print("*");
    }

    System.out.println();
}
     sc.close();

        
    }
}
